{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coach-lms.invalid/schema/whack-a-bug.schema.json",
  "title": "Coach LMS whack-a-bug pack (SPEC 13.5, 13.7)",
  "type": "object",
  "required": [
    "game",
    "id",
    "title",
    "day",
    "concepts",
    "language",
    "levels"
  ],
  "additionalProperties": false,
  "properties": {
    "$comment": {
      "type": "string"
    },
    "game": {
      "const": "whack-a-bug"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "description": "pack id (lower-case letters, digits and hyphens)"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "day": {
      "type": "integer",
      "minimum": 0
    },
    "concepts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/concept"
      }
    },
    "language": {
      "type": "string",
      "minLength": 1
    },
    "levels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/level"
      }
    }
  },
  "$defs": {
    "concept": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*(\\.[a-z0-9][a-z0-9-]*)+$",
      "description": "concept format (lower-case dotted, for example html.headings)"
    },
    "lessonCard": {
      "type": "object",
      "required": [
        "concept",
        "text"
      ],
      "additionalProperties": false,
      "properties": {
        "$comment": {
          "type": "string"
        },
        "concept": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*(\\.[a-z0-9][a-z0-9-]*)+$",
          "description": "concept format (lower-case dotted, for example html.headings)"
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "code": {
          "type": "string"
        }
      }
    },
    "level": {
      "type": "object",
      "required": [
        "id",
        "title",
        "lesson",
        "program",
        "bugs",
        "upTimeMs",
        "hint",
        "molesAtOnce"
      ],
      "additionalProperties": false,
      "properties": {
        "$comment": {
          "type": "string"
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
          "description": "level id"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "lesson": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/lessonCard"
          }
        },
        "lang": {
          "enum": [
            "snek"
          ]
        },
        "program": {
          "type": "string",
          "minLength": 1
        },
        "bugs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "line",
              "fix",
              "concept",
              "why"
            ],
            "additionalProperties": false,
            "properties": {
              "$comment": {
                "type": "string"
              },
              "line": {
                "type": "integer",
                "minimum": 1
              },
              "fix": {
                "type": "string",
                "minLength": 1
              },
              "concept": {
                "$ref": "#/$defs/concept"
              },
              "why": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "upTimeMs": {
          "type": "integer",
          "minimum": 1
        },
        "hint": {
          "enum": [
            "color",
            "none"
          ]
        },
        "molesAtOnce": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
